# All-in-one image: backend (FastAPI) + frontend (dashboard) in ONE container,
# run together by supervisord. nginx serves the built frontend on :80 and
# proxies /api, /videos, /thumbnails, /gallery, /video to the backend on
# 127.0.0.1:8000 (same container, so "backend:8000" becomes "127.0.0.1:8000").
#
# Build (prefer Docker Build Cloud — this is a heavy build):
#   docker buildx build --builder cloud-osilama2k24-osilama \
#     -f Dockerfile.allinone -t osilama2k24/openshorts-allinone:latest --push .
#
# Run:
#   docker run -d --name openshorts -p 80:80 --env-file .env \
#     -v ./output:/app/output osilama2k24/openshorts-allinone:latest
#
# Note: this bundles backend + frontend only, not the separate `renderer`
# service (render-service/, used for the AI Shorts/UGC tool). Say the word
# if you want that folded in as a third supervisord program too.

# ---------- stage 1: backend Python deps ----------
FROM python:3.11-slim AS backend-builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-billing.txt ./
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir -r requirements-billing.txt
ARG GPU=0
RUN if [ "$GPU" = "1" ]; then \
      pip install --no-cache-dir \
        "nvidia-cublas-cu12<13" "nvidia-cudnn-cu12>=9,<10" \
        onnx-asr onnxruntime-gpu; \
    fi

# ---------- stage 2: frontend static build ----------
FROM node:18-alpine AS frontend-builder
WORKDIR /app
COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm install
COPY dashboard/. .
# Empty = same-origin: the built JS calls /api/... and nginx proxies it
# internally, so no public backend URL needs to be baked in here.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_OPENPANEL_API_URL=""
ENV VITE_OPENPANEL_API_URL=$VITE_OPENPANEL_API_URL
ARG VITE_OPENPANEL_CLIENT_ID=""
ENV VITE_OPENPANEL_CLIENT_ID=$VITE_OPENPANEL_CLIENT_ID
RUN npm run build

# ---------- stage 3: final image ----------
FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    nodejs npm git fontconfig fonts-liberation fonts-noto-color-emoji \
    nginx supervisor \
    && rm -rf /var/lib/apt/lists/*

COPY --from=denoland/deno:bin /deno /usr/local/bin/deno

RUN git clone --depth 1 https://github.com/Brainicism/bgutil-ytdlp-pot-provider /opt/bgutil-provider \
    && cd /opt/bgutil-provider/server \
    && npm install --no-audit --no-fund \
    && npx tsc \
    && npm cache clean --force
ENV BGUTIL_SCRIPT_PATH=/opt/bgutil-provider/server/build/generate_once.js

COPY --from=backend-builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV LD_LIBRARY_PATH=/opt/venv/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:/opt/venv/lib/python3.11/site-packages/nvidia/cu13/lib
ENV NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

RUN pip install --upgrade --pre --no-cache-dir "yt-dlp[default]" bgutil-ytdlp-pot-provider

COPY . .

RUN mkdir -p /usr/local/share/fonts/openshorts \
    && cp fonts/*.ttf /usr/local/share/fonts/openshorts/ \
    && cp fonts/openshorts-fontmap.conf /etc/fonts/conf.d/60-openshorts.conf \
    && fc-cache -f

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser
RUN mkdir -p /app/uploads /app/output /app/.cache/huggingface /tmp/Ultralytics
RUN chown -R appuser:appuser /app /tmp/Ultralytics

# Pre-download the YOLO model as appuser (matches the backend-only image),
# then switch back to root — supervisord needs root to run nginx and to
# drop the backend process to appuser itself.
USER appuser
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
USER root

# ---- wire in the built frontend ----
COPY --from=frontend-builder /app/dist /usr/share/nginx/html
COPY nginx.allinone.conf /etc/nginx/conf.d/default.conf
RUN rm -f /etc/nginx/sites-enabled/default

# ---- process manager: runs nginx + uvicorn together ----
COPY supervisord.allinone.conf /etc/supervisor/conf.d/openshorts.conf

EXPOSE 80
EXPOSE 8000

# Healthy only once the backend actually answers AND nginx is serving the UI.
HEALTHCHECK --interval=5s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -sf http://127.0.0.1:8000/health/ready > /dev/null && curl -sf http://127.0.0.1/ > /dev/null || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
